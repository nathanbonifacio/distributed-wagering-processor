# Copie para .env (`cp .env.example .env`). O .env é ignorado pelo git; este arquivo é versionado.
# Somente valores FICTÍCIOS de desenvolvimento local. Nunca coloque credenciais reais aqui.
#
# Quem lê este arquivo:
#  - Docker Compose: interpola ${VAR} em docker-compose.yml (portas, usuário/senha do Postgres).
#  - Bun: carrega .env sozinho em `bun run` e `bun test` (processos no host Windows/Linux).
# Os containers NÃO recebem o DATABASE_URL/SQS_ENDPOINT daqui: o Compose monta os endereços
# internos (hosts `postgres` e `localstack`) a partir dos componentes abaixo.

# --- PostgreSQL (container e componentes da URL interna) ---
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_PORT=5432

# --- LocalStack / AWS (credenciais fictícias exigidas pelo SDK) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
# Opcional: só se a sua imagem do LocalStack exigir token (a 4.4 não exige).
LOCALSTACK_AUTH_TOKEN=

# --- Endereços usados por processos NO HOST (bun run / bun test): localhost ---
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
SQS_ENDPOINT=http://localhost:4566

# --- Aplicação (opcionais; estes são os defaults) ---
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_EVENTS_QUEUE_NAME=wager-events
HEALTH_CHECK_TIMEOUT_MS=2000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
